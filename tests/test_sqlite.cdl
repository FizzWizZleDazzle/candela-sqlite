// Exercises the binding end to end on a temporary file database. Run with
// `candela run tests/test_sqlite.cdl` after ./build-native.sh.
import "std/assert" as assert;
import "../src/main.cdl";
import "../src/schema.cdl" as schema;

fn main() {
    let path = "test_sqlite.db";
    if fs::exists(path) {
        fs::delete(path);
    }
    let db = open(path);

    db.exec("create table people (id integer primary key, name text not null, age integer, score real)");
    assert::assert_eq(schema::tables(db), ["people"]);
    let cols = schema::columns(db, "people");
    assert::assert_eq(cols.len(), 4);
    assert::assert_eq(cols[0].name, "id");
    assert::assert_true(cols[0].primary_key);
    assert::assert_eq(cols[1].kind, "TEXT");
    assert::assert_true(cols[1].not_null);
    assert::assert_false(cols[2].not_null);

    // insert through a map, with identifiers quoted for us
    let first = db.insert("people", {"name": Value::Text("Ada"), "age": Value::Int(36), "score": Value::Real(9.5)});
    assert::assert_eq(first, 1);
    db.insert("people", {"name": Value::Text("Grace"), "age": Value::Int(45), "score": Value::Null});
    assert::assert_eq(db.last_rowid(), 2);

    // a prepared statement bound and run more than once
    let stmt = db.prepare("insert into people (name, age, score) values (?, ?, ?)");
    stmt.bind_all([Value::Text("Linus"), Value::Int(28), Value::Real(7.25)]);
    stmt.run();
    stmt.bind_all([Value::Text("O'Brien"), Value::Null, Value::Real(1.0)]);
    stmt.run();
    stmt.finalize();

    // read back, typed
    let rows = db.query("select id, name, age, score from people order by id");
    assert::assert_eq(rows.len(), 4);
    assert::assert_eq(rows[0].get<string>("name"), "Ada");
    assert::assert_eq(rows[0].get<int>("age"), 36);
    assert::assert_eq(rows[0].get<float>("score"), 9.5);
    assert::assert_true(rows[1].cell("score").is_null());
    assert::assert_eq(rows[3].get<string>("name"), "O'Brien");
    assert::assert_true(rows[3].cell("age").is_null());
    assert::assert_eq(rows[3].names, ["id", "name", "age", "score"]);

    // parameters of every kind, and a where clause
    let older = db.query_with("select name from people where age > ? order by name", [Value::Int(30)]);
    assert::assert_eq(older.len(), 2);
    assert::assert_eq(older[0].get<string>("name"), "Ada");
    assert::assert_eq(older[1].get<string>("name"), "Grace");

    // update and delete report their row counts
    assert::assert_eq(db.run("update people set age = age + 1 where age is not null"), 3);
    assert::assert_eq(db.run_with("delete from people where name = ?", [Value::Text("Linus")]), 1);
    assert::assert_eq(db.query("select count(*) as n from people")[0].get<int>("n"), 3);

    // a bad column name, a bad statement, and a bad bind count all raise
    let raised = "";
    try {
        rows[0].cell("nope");
    } catch e {
        raised = e;
    }
    assert::assert_eq(raised, "sqlite_no_such_column");

    raised = "";
    try {
        db.exec("select * from missing_table");
    } catch e {
        raised = e;
    }
    assert::assert_true(raised.starts_with("sqlite_error: no such table"));

    raised = "";
    try {
        db.query_with("select ?", [Value::Int(1), Value::Int(2)]);
    } catch e {
        raised = e;
    }
    assert::assert_eq(raised, "sqlite_bind_count");

    db.close();
    fs::delete(path);
    print("sqlite ok");
}
